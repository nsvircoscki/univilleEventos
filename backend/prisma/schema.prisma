generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}
model User {
  id            String @id @default(uuid())
  name          String
  email         String @unique
  login         String @unique
  password_hash String?
  ativo         Boolean @default(true)
  roleId        String
  role          Role @relation(fields: [roleId], references: [id])
  solicitacoes  Evento[] @relation("Solicitante")
  decisoes      Evento[] @relation("Revisor")
  sessoes       Sessao[]
}
model Tema {
  id String @id @default(uuid())
  nome String @unique
  eventos Evento[]
}
model Recurso {
  id String @id @default(uuid())
  nome String @unique
  ambientes AmbienteRecurso[]
  eventos EventoRecurso[]
}
model Ambiente {
  id String @id @default(uuid())
  nome String @unique
  recursos AmbienteRecurso[]
  eventos Evento[]
}
model AmbienteRecurso {
  ambienteId String
  recursoId String
  ambiente Ambiente @relation(fields: [ambienteId], references: [id], onDelete: Cascade)
  recurso Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  @@id([ambienteId, recursoId])
}
model Curso {
  id String @id @default(uuid())
  nome String @unique
  centroCusto String
  eventos Evento[]
}
model EventoRecurso {
  eventoId String
  recursoId String
  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  recurso Recurso @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  @@id([eventoId, recursoId])
}

model Sessao {
  id       String @id
  usuarioId String
  usuario  User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm DateTime
  @@index([expiraEm])
  @@index([usuarioId])
}

enum StatusEvento {
  RASCUNHO
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

model Evento {
  id             String @id @default(uuid())
  titulo         String
  descricao      String @default("")
  tema           String @default("")
  palestrante    String @default("")
  solicitanteTexto String @default("")
  publicoAlvo    String @default("")
  justificativa  String @default("")
  objetivo       String @default("")
  cerimonial     Boolean @default(false)
  haveraInscricoes Boolean @default(false)
  necessidadeDeclaracoes Boolean @default(false)
  recursosNecessarios String @default("")
  observacoes    String @default("")
  centroCusto    String @default("")
  local          String
  localChave     String
  inicio         DateTime
  fim            DateTime
  status         StatusEvento @default(PENDENTE)
  motivo         String?
  criadoEm       DateTime @default(now())
  decididoEm     DateTime?
  solicitanteId  String
  solicitante    User @relation("Solicitante", fields: [solicitanteId], references: [id])
  revisorId      String?
  revisor        User? @relation("Revisor", fields: [revisorId], references: [id])
  atualizadoEm   DateTime @updatedAt
  canceladoEm    DateTime?
  temaId         String?
  temaRef        Tema? @relation(fields: [temaId], references: [id], onDelete: SetNull)
  ambienteId     String?
  ambiente       Ambiente? @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  cursoId        String?
  curso          Curso? @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  recursos       EventoRecurso[]

  @@index([status, inicio, fim])
  @@index([localChave, status, inicio, fim])
  @@index([solicitanteId, criadoEm])
}
