generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}
model User {
  id            String @id @default(uuid())
  name          String
  email         String @unique
  login         String @unique
  password_hash String?
  ativo         Boolean @default(true)
  roleId        String
  role          Role @relation(fields: [roleId], references: [id])
}
